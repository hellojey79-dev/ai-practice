# ==========================================
# Python 가상환경 및 패키지 매니저
# ==========================================
.venv/
venv/
ENV/
env/
*.venv/

# ==========================================
# Node.js 의존성
# ==========================================
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ==========================================
# Python 바이트코드 및 캐시
# ==========================================
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ==========================================
# 환경 변수, 보안 키, 인증 정보 (보안 필수)
# ==========================================
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.pfx
credentials.json
client_secrets.json
token.json
*secret*
*apikey*

# ==========================================
# 임시 파일, 백업 파일, 로그
# ==========================================
*.bak
**/*.bak
*.tmp
*.temp
*.swp
*.swo
*~
*.log
**/scratch/

# ==========================================
# 운영체제 및 IDE 임시 설정
# ==========================================
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# ==========================================
# 숨김 폴더/파일 기본 무시 및 특정 스킬 예외 허용
# ==========================================
.*
!.gitignore
!.agents/
.agents/*
!.agents/skills/
.agents/skills/*
!.agents/skills/py-eda/
!.agents/skills/marp-slides/

